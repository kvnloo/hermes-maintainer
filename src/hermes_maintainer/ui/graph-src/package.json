{
  "name": "hermes-maintainer-graph",
  "private": true,
  "type": "module",
  "description": "Bundled xyflow canvas for the local dashboard. Run ../../../scripts/build-ui.sh",
  "scripts": {
    "build": "esbuild graph-app.jsx --bundle --format=iife --outfile=../static/graph-app.js --minify --jsx=automatic",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xyflow/react": "12.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "esbuild": "0.25.0",
    "jsdom": "26.1.0",
    "vitest": "3.2.4"
  }
}
