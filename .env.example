# GitHub read token. A fine-grained token with repository read access is enough for scans.
GITHUB_TOKEN=

# Optional override for the config file.
HERMES_MAINTAINER_CONFIG=config/hermes-maintainer.toml

# Optional local-only Hermes ACP chat; enabled explicitly in your local shell.
# Do not put live model credentials or GitHub write tokens in this public repo.
HERMES_MAINTAINER_ACP_ENABLED=0
# HERMES_MAINTAINER_ACP_COMMAND="hermes acp"
# HERMES_MAINTAINER_ACP_WORKSPACE="/path/to/authorized/fork"

